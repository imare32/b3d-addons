{
  // 本仓库按「方式 A」注册为本地扩展仓库：仓库 id = b3d_addons，
  // 目录直接指向工作区根（use_custom_directory = true，custom_directory = C:\git\b3d-addons）。
  // 于是每个含 blender_manifest.toml 的子目录都被自动发现，模块名是 bl_ext.b3d_addons.<ext_id>。
  //
  // `blender.addonFolders` 故意留空：Blender 自己会扫全部子目录，再让启动器往
  // vscode_development / 仓库目录里造链接，只会在两处重复登记（而且那份手写列表迟早会过期）。
  "blender.addon.extensionsRepository": "b3d_addons",
  "blender.addonFolders": []
}
